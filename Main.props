<?xml version="1.0"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <AssemblyName>IC10Editor</AssemblyName>
    <Description>Alternative IC10 Editor for Stationeers based on ImGui</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Compression" Version="4.3.0" />
    <PackageReference Include="System.IO.Compression.ZipFile" Version="4.3.0" />
  </ItemGroup>
  <!-- Optional: Set 'StationeersDirectory' inside 'User.props' if it's not found automatically or you want to force a specific Stationeers directory -->
  <Import Condition="Exists('User.props')" Project="User.props" />
</Project>
